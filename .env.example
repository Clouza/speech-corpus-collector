# required for YouTube Data API v3 discovery
YOUTUBE_API_KEY=

# required for OpenSubtitles REST API discovery and downloads
OPENSUBTITLES_API_KEY=

# optional account credentials used to request a bearer token at runtime
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# required only for the proof-of-concept corpus API; use at least 32 random characters
CORPUS_API_SECRET=
